{
    "compilerOptions": {
        "target": "ESNext",
        "module": "BaseNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "client/**/*",
        "convex/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}